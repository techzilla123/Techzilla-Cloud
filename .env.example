GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_TAKEOUT_DIR=C:\Users\YOUR_NAME\Google Drive\My Drive\Takeout
GOOGLE_MEDIA_FOLDER_NAME=Techzilla Media

# After a successful import, delete the synced Takeout ZIP to avoid keeping both
# the archive and extracted media in Drive. This is safe only when the local
# folder is the synced Google Drive Takeout folder.
DELETE_IMPORTED_TAKEOUT_ARCHIVES=false

# ZIPs newer than this are treated as still syncing.
ARCHIVE_STABLE_MINUTES=10

# Used by `npm run media:watch`; the importer scans at this interval.
MEDIA_POLL_MINUTES=30

# Public Dropbox folders containing photos and videos. The importer needs no
# Dropbox API key or sign-in; keep both folders shared with anyone who has the link.
DROPBOX_MEDIA_FOLDER_URL_1=
DROPBOX_MEDIA_FOLDER_URL_2=
